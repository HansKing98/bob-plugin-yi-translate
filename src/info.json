{
  "identifier": "com.hans.bob-plugin-yi-translate",
  "version": "1.1.0",
  "category": "translate",
  "name": "Yi Translate",
  "summary": "支持 OpenAI 兼容 API、自定义 Base URL / API Key 和实时模型查询",
  "icon": "icon.png",
  "author": "hans <admin@hansking.cn>",
  "homepage": "https://github.com/hansking98/bob-plugin-yi-translate",
  "appcast": "https://raw.githubusercontent.com/hansking98/bob-plugin-yi-translate/main/appcast.json",
  "minBobVersion": "0.5.0",
  "options": [
    {
      "identifier": "mode",
      "type": "menu",
      "title": "模式",
      "defaultValue": "translate",
      "menuValues": [
        {
          "title": "翻译模式",
          "value": "translate"
        },
        {
          "title": "文字润色",
          "value": "polishing"
        },
        {
          "title": "对话模式",
          "value": "chat"
        },
        {
          "title": "自定义prompt",
          "value": "custom_prompt"
        },
        {
          "title": "查询模型列表",
          "value": "models"
        }
      ],
      "desc": "也可在翻译框输入 #models 或 #模型，实时查询模型列表"
    },
    {
      "identifier": "prompt",
      "type": "text",
      "defaultValue": "",
      "title": "自定义prompt",
      "desc": "模式选择自定义prompt时填写,GPT会按照你指定的prompt进行回复"
    },
    {
      "identifier": "service",
      "type": "menu",
      "title": "默认供应商",
      "defaultValue": "default",
      "menuValues": [
        {
          "title": "Yi Model API",
          "value": "default"
        },
        {
          "title": "自定义API地址",
          "value": "api_key_1"
        }
        
      ],
      "desc": "填写 Base URL 后始终优先使用该地址；Yi 选项留空时使用默认地址"
    },
    {
      "identifier": "url",
      "type": "text",
      "defaultValue": "",
      "title": "Base URL",
      "desc": "OpenAI 兼容地址，如 https://api.openai.com/v1 或 http://localhost:11434/v1；兼容完整 /chat/completions 地址"
    },
    {
      "identifier": "api_key",
      "type": "text",
      "defaultValue": "",
      "title": "API Key",
      "desc": "当前服务的密钥，以 Bearer 认证发送；本地无鉴权服务可留空。Bob 1.6+ 的验证按钮会实时请求 /models"
    },
    {
      "identifier": "model",
      "type": "menu",
      "title": "模型",
      "defaultValue": "yi-lightning",
      "menuValues": [
        {
          "title": "yi-34b-chat-0205",
          "value": "yi-34b-chat-0205"
        },
        {
          "title": "yi-lightning",
          "value": "yi-lightning"
        }
      ],
      "desc": "模型切换"
    },
    {
      "identifier": "custom_model_name",
      "type": "text",
      "defaultValue": "",
      "title": "自定义模型名",
      "desc": "优先于预设模型；填写 #models 查询得到的模型 ID，留空使用预设模型"
    }
  ]
}
